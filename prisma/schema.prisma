generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model Funcionario {
  id           Int          @id @default(autoincrement())
  nome         String
  email        String       @unique
  cargo        String?
  salario      Decimal?     @db.Decimal(12, 2)
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt
  excluidoEm   DateTime? 

  alocacoes    Alocacao[]

  @@map("funcionarios")
}

model Obra {
  id           Int          @id @default(autoincrement())
  nome         String
  endereco     String?
  status       String        @default("PLANEJADA")
  dataInicio   DateTime?
  dataFim      DateTime?
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt
  excluidoEm   DateTime? 

  alocacoes    Alocacao[]

  @@map("obras")
}

model Alocacao {
  id            Int         @id @default(autoincrement())
  funcionarioId Int
  obraId        Int
  criadoEm      DateTime    @default(now())

  funcionario   Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)
  obra          Obra        @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@unique([funcionarioId, obraId])
  @@map("alocacoes")
}